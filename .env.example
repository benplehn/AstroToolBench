# NVIDIA API Catalog.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=

# OpenRouter alternative: change BOTH the URL and the model ID.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# OPENROUTER_API_KEY=

# For any other compatible endpoint, set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY.
# LLM_API_KEY takes precedence over the matching provider-specific key.

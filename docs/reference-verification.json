      "transfer_composition": {
        "families": [
          "transfer_then_propagation",
          "transfer_then_eclipse",
          "transfer_arrival_eclipse"
        ],
        "rationale": "Dependent transfer/propagation/shadow workflows are held out as complete compositions.",
        "split": "test"
      },
      "unit_contract": {
        "families": [
          "invalid_units"
        ],
        "rationale": "Mixed position/velocity units are the same dimensional-consistency failure.",
        "split": "train"
      }
    },
